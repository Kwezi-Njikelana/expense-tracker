NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
# Max connections in the pool; keep this low on serverless/free-tier Postgres
DATABASE_POOL_MAX=10
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Only needed if the client is served from a different origin than the API
CORS_ORIGIN=
LOG_LEVEL=info
